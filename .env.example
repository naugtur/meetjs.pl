# Copy this file to .env to get started; deploy platforms provide the real
# values as environment variables. Every variable is declared and validated
# in env.ts — server vars at boot (runtime process.env reads), VITE_-prefixed
# client vars at build time (baked into the bundle; never put secrets there).

EVENTS_API_URL=http://localhost:3000/api/mocked/crossweb
DISCORD_SERVER_ID=735954756169760768
SPEAKERS_API_URL=https://crossweb.pl/api/meetjs/speakers
SPEAKERS_API_TOKEN=<your_crossweb_api_token>

# Public site URL — used for canonical links and Open Graph tags.
VITE_SITE_URL=http://localhost:3000

# Tolgee CLI API Key (only needed for CI/CD)
# For local development, use: pnpm tolgee login <your_api_key>
# TOLGEE_API_KEY=<your_tolgee_cli_api_key>
