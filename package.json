    "parity:compare": "node scripts/parity/compare.mjs",
    "parity:run": "node scripts/parity/run.mjs",
    "parity:functional": "node scripts/parity/functional.mjs",
    "parity:fixtures": "node scripts/parity/fixtures-server.mjs",
    "parity:next-baseline": "bash scripts/parity/next-baseline.sh"
  },
